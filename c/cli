#ifdef DEBUG
#define dprintf if (1) printf
#else
#define dprintf if (0) printf
#endif


/***************************************************************************
 * Function:     cliv_is_terminator
 * Description:  Report whether a character terminates a CLI string
 * Parameters:   ch = character to test
 * Returns:      Non-zero if the character terminates the command
 **************************************************************************/
static int cliv_is_terminator(int ch)
{
    return (ch == '\0' || ch == '\r' || ch == '\n');
}


/***************************************************************************
 * Function:     cliv_skip_leading
 * Description:  Skip leading spaces and '*' characters
 * Parameters:   command_line = command line to inspect
 * Returns:      Pointer to the first significant character
 **************************************************************************/
static const char *cliv_skip_leading(const char *command_line)
{
    while (*command_line == ' ' || *command_line == '*')
    {
        command_line++;
    }

    return command_line;
}


/***************************************************************************
 * Function:     cliv_command_length
 * Description:  Measure a command up to its terminating character
 * Parameters:   command_line = command line to inspect
 * Returns:      Length of the command
 **************************************************************************/
static size_t cliv_command_length(const char *command_line)
{
    const char *start;

    start = command_line;
    while (!cliv_is_terminator(*command_line))
    {
        command_line++;
    }

    return (size_t)(command_line - start);
}


/***************************************************************************
 * Function:     cliv_split_command
 * Description:  Split a CLI line into command and argument components
 * Parameters:   command_line = command line to inspect
 *               command_len  = updated with the command token length
 *               args         = updated with the argument pointer
 * Returns:      none
 **************************************************************************/
static void cliv_split_command(const char *command_line,
                               size_t *command_len,
                               const char **args)
{
    const char *p;

    p = command_line;
    while (*p != ' ' && !cliv_is_terminator(*p))
    {
        p++;
    }

    *command_len = (size_t)(p - command_line);
    if (*p == ' ')
    {
        p++;
    }
    *args = p;
}


/***************************************************************************
 * Function:     cliv_dispatch
 * Description:  Handle the subset of CLI processing currently implemented
 * Parameters:   command_line = command line presented through CliV
 * Returns:      Non-zero if the command was handled by this module
 **************************************************************************/
int cliv_dispatch(const char *command_line)
{
    const char *cmd;
    const char *args;
    const char *command;
    const char *tail;
    const char *special;
    char *command_copy;
    char *command_token;
    size_t cmd_len;
    size_t command_len;
    int old_fs;
    int restore_fs;
    int handled;
    int process_aliases;
    _kernel_oserror *err;

    cmd = cliv_skip_leading(command_line);
    if (cliv_is_terminator(*cmd))
    {
        return 1;
    }

    if (*cmd == '|')
    {
        return 1;
    }

    cmd_len = cliv_command_length(cmd);
    if (cmd_len > cliv_line_limit)
    {
        dprintf("CLIV: passing on overlong command line\n");
        return 0;
    }

    if (cliv_redirection_requires_passthrough(cmd))
    {
        dprintf("CLIV: passing on command with redirection\n");
        return 0;
    }

    cliv_split_command(cmd, &command_len, &args);
    command_copy = (char *)malloc(command_len + 1);
    if (command_copy == NULL)
    {
        return 0;
    }

    memcpy(command_copy, cmd, command_len);
    command_copy[command_len] = '\0';

    handled = 0;
    restore_fs = 0;
    old_fs = -1;
    special = NULL;

    err = cliv_os_set_tempfs(command_copy, &tail, &old_fs, &special);
    if (err != NULL)
    {
        free(command_copy);
        return 0;
    }

    if (old_fs >= 0)
    {
        restore_fs = 1;
    }

    if (special != NULL)
    {
        dprintf("CLIV: passing on command with special field\n");
        goto finish;
    }

    if (*tail == '\0')
    {
        handled = 1;
        goto finish;
    }

    cliv_split_command(tail, &command_len, &args);
    command_token = (char *)malloc(command_len + 1);
    if (command_token == NULL)
    {
        goto finish;
    }

    memcpy(command_token, tail, command_len);
    command_token[command_len] = '\0';
    command = command_token;

    if (cliv_module_prefix_requires_passthrough(command))
    {
        dprintf("CLIV: passing on directed module command\n");
        free(command_token);
        goto finish;
    }

    if (command[0] == '/')
    {
        if (args[0] == '\0')
        {
            err = cliv_os_run_file(command + 1);
            if (err == NULL)
            {
                handled = 1;
            }
        }
        free(command_token);
        goto finish;
    }

    process_aliases = 1;
    if (command[0] == '%')
    {
        process_aliases = 0;
        command++;
    }

    if (process_aliases)
    {
        if (!cliv_try_alias(command, args, &handled))
        {
            free(command_token);
            goto finish;
        }

        if (handled)
        {
            free(command_token);
            goto finish;
        }
    }

    if (cliv_alias_handling_requires_passthrough(command))
    {
        dprintf("CLIV: passing on command needing module dispatch fallback\n");
        free(command_token);
        goto finish;
    }

    free(command_token);

finish:
    if (restore_fs)
    {
        err = cliv_os_restore_tempfs();
        if (err != NULL)
        {
            handled = 0;
        }
    }

    free(command_copy);
    return handled;
}
