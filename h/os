#ifndef CLIV_OS_H
#define CLIV_OS_H

#include <stdint.h>

#include "kernel.h"

#define VarType_String          0
#define VarType_Number          1
#define VarType_Macro           2
#define VarType_Expanded        3   // given to Read, this always returns a string
                                    // given to Set,  this means evaluate an expression
#define VarType_LiteralString   4   // Only valid for Set - sets the string as is (no
                                    // GSTrans)
#define VarType_Evaluated       5   // given to Read, this means evaluate expression value
                                    // given to Set,  this always stores a string
#define VarType_Code            16

#define ErrorNumber_VarNoRroom   (0x123)
#define ErrorNumber_VarCantFind  (0x124)
#define ErrorNumber_VarTooLong   (0x125)
#define ErrorNumber_BuffOverflow (0x1e4)


/*******************************************************************
 Function:      cliv_os_claim_vector
 Description:   Claim the CliV vector for this module instance
 Parameters:    pw = private word for the module instance
 Returns:       Error pointer, or NULL on success
 ******************************************************************/
_kernel_oserror *cliv_os_claim_vector(void *pw);

/*******************************************************************
 Function:      cliv_os_release_vector
 Description:   Release the CliV vector for this module instance
 Parameters:    pw = private word for the module instance
 Returns:       Error pointer, or NULL on success
 ******************************************************************/
_kernel_oserror *cliv_os_release_vector(void *pw);


/*************************************************** Gerph *********
 Function:      os_readvarval
 Description:   Read a variable value
 Parameters:    var-> the variable name to read
                buf-> the buffer to write to
                buflen = length of the buffer, or -1 to just read length
                context = the context for the call, or 0 for first call
                type = the variable type to read (3 to expand on return)
                sizep-> where to store the size that was read
                contextp-> where to store the context value
                typep-> where to store the type
 Returns:       error pointer, or NULL if ok
 ******************************************************************/
_kernel_oserror *os_readvarval(const char *var, char *buf, int buflen, uint32_t context, int type,
                               uint32_t *contextp, int32_t *sizep, int32_t *typep);

/*************************************************** Gerph *********
 Function:      os_fscontrol_cat
 Description:   Catalogue a directory through OS_FSControl
 Parameters:    path-> the directory path to catalogue
 Returns:       pointer to error, or NULL if no error
 ******************************************************************/
_kernel_oserror *os_fscontrol_cat(const char *path);

/*************************************************** Gerph *********
 Function:      os_cli
 Description:   Run a CLI command
 Parameters:    cli-> the command line to run
 Returns:       pointer to error, or NULL if no error
 ******************************************************************/
_kernel_oserror *os_cli(const char *cli);

/*******************************************************************
 Function:      cliv_os_set_tempfs
 Description:   Apply OS_FSControl 11 to a command token
 Parameters:    command = command token to inspect
                tail    = updated with the remaining token
                old_fs  = updated with the previous FS number
                special = updated with any special field pointer
 Returns:       Error pointer, or NULL on success
 ******************************************************************/
_kernel_oserror *cliv_os_set_tempfs(const char *command,
                                    const char **tail,
                                    int *old_fs,
                                    const char **special);

/*******************************************************************
 Function:      cliv_os_restore_tempfs
 Description:   Restore the current filing system after a temporary change
 Parameters:    none
 Returns:       Error pointer, or NULL on success
 ******************************************************************/
_kernel_oserror *cliv_os_restore_tempfs(void);

/*******************************************************************
 Function:      cliv_os_run_file
 Description:   Run a file through OS_FSControl 4
 Parameters:    filename = file to run
 Returns:       Error pointer, or NULL on success
 ******************************************************************/
_kernel_oserror *cliv_os_run_file(const char *filename);

/*******************************************************************
 Function:      cliv_os_substitute_args
 Description:   Expand a template through OS_SubstituteArgs
 Parameters:    args            = argument list
                no_append       = non-zero to suppress appended leftovers
                output          = destination buffer
                output_length   = length of destination buffer
                template_string = template to expand
                template_length = length of the template to use
                result_length   = updated with output size including NUL
 Returns:       Error pointer, or NULL on success
 ******************************************************************/
_kernel_oserror *cliv_os_substitute_args(const char *args,
                                         int no_append,
                                         char *output,
                                         int output_length,
                                         const char *template_string,
                                         int template_length,
                                         int *result_length);

/*******************************************************************
 Function:      cliv_os_service_ukcommand
 Description:   Issue Service_UKCommand
 Parameters:    command   = command line to present
                claimed   = updated with the claim state
                error_ptr = updated with the service error pointer
 Returns:       Error pointer, or NULL on success
 ******************************************************************/
_kernel_oserror *cliv_os_service_ukcommand(const char *command,
                                           int *claimed,
                                           _kernel_oserror **error_ptr);

#endif
